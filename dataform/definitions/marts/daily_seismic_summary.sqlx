config {
  type: "table",
  schema: "quakes_marts",
  name: "daily_seismic_summary",
  description: "One row per event date, network code and event type",

  // This is the line that makes the break test work. Without it the mart
  // depends on the staging table and rebuilds happily from a table whose
  // assertions just failed. With it, the mart is SKIPPED instead.
  dependOnDependencyAssertions: true,

  bigquery: {
    partitionBy: "event_date",
    clusterBy: ["region"]
  },
  assertions: {
    uniqueKey: ["event_date", "region", "event_type"],
    nonNull: ["event_date", "region", "event_type", "event_count"]
  },
  columns: {
    event_type: "Grouped, not filtered. all_month carries quarry blasts and explosions"
  }
}

SELECT
  DATE(event_time)                             AS event_date,
  region,
  event_type,
  COUNT(*)                                     AS event_count,
  ROUND(AVG(magnitude), 3)                     AS avg_magnitude,
  MAX(magnitude)                               AS max_magnitude,
  APPROX_QUANTILES(magnitude, 100)[OFFSET(50)] AS median_magnitude,
  COUNTIF(magnitude >= 5.0)                    AS significant_count,
  ROUND(AVG(depth), 2)                         AS avg_depth_km,
  COUNTIF(tsunami = 1)                         AS tsunami_flagged,
  MAX(updated_time)                            AS source_last_updated
FROM ${ref("stg_quakes")}
WHERE event_time >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 90 DAY)
GROUP BY event_date, region, event_type
