config {
  type: "table",
  schema: "quakes_staging",
  name: "stg_quakes",
  description: "One row per earthquake event. Latest USGS revision wins.",
  bigquery: {
    partitionBy: "DATE(event_time)",
    clusterBy: ["region"]
  },
  assertions: {
    uniqueKey: ["event_id"],
    nonNull: ["event_id", "event_time"]
  },
  columns: {
    event_id: "USGS event id. Unique in this table, not in the source",
    region: "USGS network code such as ak, ci, us, hv. Not a geographic region",
    event_type: "earthquake, quarry blast, explosion, ice quake, landslide",
    ingested_at: "When the ingest job wrote the winning row"
  }
}

SELECT
  event_id,
  event_time,
  updated_time,
  region,
  event_type,
  magnitude,
  magnitude_type,
  place,
  latitude,
  longitude,
  depth,
  status,
  tsunami,
  ingested_at
FROM ${ref("quakes_native")}

-- Not decoration. Once require_partition_filter is true on quakes_native, a
-- model with no filter on event_time fails to run at all. 90 days is a choice,
-- and this is where it is written down.
WHERE event_time >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 90 DAY)

-- The dedup. Number rows within each event_id, newest revision first, keep 1.
-- updated_time answers "which version is current". ingested_at breaks ties
-- when two runs picked up the same unrevised event.
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY event_id
  ORDER BY updated_time DESC, ingested_at DESC
) = 1
