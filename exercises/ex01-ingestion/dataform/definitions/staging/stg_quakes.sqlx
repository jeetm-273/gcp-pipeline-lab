config {
  type: "table",
  schema: "quakes",
  name: "stg_quakes"
}

SELECT
  event_id,
  event_time,
  updated_time,
  region,
  magnitude,
  magnitude_type,
  place,
  latitude,
  longitude,
  depth,
  status,
  tsunami
FROM `${dataform.projectConfig.defaultDatabase}.quakes.quakes_native`
WHERE event_time >= TIMESTAMP("2000-01-01")
